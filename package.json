{
  "name": "program-truth",
  "version": "0.3.0",
  "description": "Program Truth gathers and synthesizes execution-level evidence into a canonical, machine-readable status artifact; Truth Tools validates it.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "program-truth": "bin/program-truth.js"
  },
  "files": [
    "bin/",
    "lib/",
    "examples/",
    "references/",
    "docs/",
    "evaluation/",
    "case-studies/",
    "schemas/",
    "scripts/",
    "test/",
    "SKILL.md",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/args.test.js && node test/bootstrap.test.js && node test/install.test.js && node test/status-artifact.test.js && node test/public-package-contract.test.js && node test/status-artifact-smoke.test.js && node test/truth-tools-sibling.test.js",
    "check": "node scripts/check-syntax.js",
    "contracts:verify": "node scripts/contracts-verify.js",
    "smoke:status-artifact": "node scripts/status-artifact-smoke.js",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run check && npm run contracts:verify && npm test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hilmimuktitama/program-truth.git"
  },
  "bugs": {
    "url": "https://github.com/hilmimuktitama/program-truth/issues"
  },
  "homepage": "https://github.com/hilmimuktitama/program-truth#readme",
  "keywords": [
    "codex",
    "claude",
    "skill",
    "tpm",
    "program-management",
    "status-artifact",
    "jira",
    "confluence",
    "notion"
  ],
  "engines": {
    "node": ">=22"
  }
}
